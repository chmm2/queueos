# --- Backend configuration ---
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/queue-platform

# ML (FastAPI) prediction service
ML_SERVICE_URL=http://localhost:6000/predict
ML_TIMEOUT_MS=1500

# Auth — CHANGE JWT_SECRET to a long random string in production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS: the frontend origin allowed to call the API / open sockets
CLIENT_URL=http://localhost:5173

# Base URL of the public web app, used inside QR codes (join + tracking links)
PUBLIC_WEB_URL=http://localhost:5173

# No-show handling: grace window before a held/skipped token is auto-missed
RECALL_WINDOW_SECONDS=300
AUTO_MISS_INTERVAL_MS=30000

# Email notifications (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@queueplatform.com

# SMS via Twilio (optional — leave blank to disable).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# WhatsApp (optional — leave blank to disable). Tried in this order, use
# whichever you can actually get: also powers OTP delivery on the public
# join flow.
#
# 1. Meta WhatsApp Cloud API — free tier, 1,000 conversations/month, no card.
#    From developers.facebook.com -> your App -> WhatsApp -> API Setup.
#    Gated by your Meta Business Portfolio's registered country; not
#    available everywhere.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
# 2. Twilio WhatsApp Sandbox — permanently free, no business verification,
#    available worldwide. Reuses TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN above.
#    TWILIO_WHATSAPP_FROM is the shared sandbox number, e.g.
#    "whatsapp:+14155238886" — each recipient must first WhatsApp it the
#    join code shown in the Twilio console (Messaging -> Try WhatsApp).
TWILIO_WHATSAPP_FROM=
